# Optional AI backend only. GitHub Pages cannot run server-side code.
HOST=127.0.0.1
PORT=8000
# Complete HTTPS URL of a provider's chat-completions endpoint.
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=
# Default: only send records with 已审核/已复核/审核通过 status to a model.
ALLOW_UNREVIEWED_AI=false
# Required when running on a public host. Visitors enter this site token, never the model key.
ATLAS_ACCESS_TOKEN=
# Public origin of the same-host frontend behind your HTTPS reverse proxy, no trailing slash.
PUBLIC_ORIGIN=
